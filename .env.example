# Copy to .env and fill in. Never commit .env.

# Provider API keys (read by LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models (LiteLLM model strings)
SOA_MODEL_PRIMARY=gpt-4o-mini
SOA_MODEL_SECONDARY=anthropic/claude-haiku-4-5-20251001

# Agent settings
SOA_MAX_ATTEMPTS=3
SOA_LOG_PATH=logs/attempts.jsonl
