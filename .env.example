# Copy to .env and fill in. Never commit .env.

# Provider API keys (read by LiteLLM)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Models (LiteLLM model strings)
# Primary: Gemini, used through Phase 5. Format: gemini/<model>
SOA_MODEL_PRIMARY=
# Secondary: OpenRouter, for the Phase 6 eval comparison. Format: openrouter/<provider>/<model>
SOA_MODEL_SECONDARY=

# Agent settings
SOA_MAX_ATTEMPTS=3
SOA_LOG_PATH=logs/attempts.jsonl
