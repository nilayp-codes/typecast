# Copy to .env and fill in. Never commit .env.

# Provider API key (read by LiteLLM). Both models go through OpenRouter.
OPENROUTER_API_KEY=

# Models (LiteLLM model strings, format: openrouter/<provider>/<model>)
# Primary = the weak model: the baseline and the default for `soa extract` through Phase 5.
SOA_MODEL_PRIMARY=openrouter/qwen/qwen-2.5-7b-instruct
# Secondary = the strong model: the Phase 6 eval comparison against the weak one.
SOA_MODEL_SECONDARY=openrouter/qwen/qwen3-235b-a22b-2507

# Agent settings
SOA_MAX_ATTEMPTS=3
SOA_LOG_PATH=logs/attempts.jsonl
